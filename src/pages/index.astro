---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Screenshots (QGIS)
import screenDemnas from '../assets/img/screenshot_demnas.png';
import screenRbi from '../assets/img/screenshot_rbi.png';
import screenBatnas from '../assets/img/screenshot_batnas.png';
import screenLogin from '../assets/img/screenshot_login.png';

// Screenshots (ArcGIS Pro)
import screenProLogin from '../assets/img/screenshot_pro_login.png';
import screenProRbi from '../assets/img/screenshot_pro_rbi.png';
import screenProDemnas from '../assets/img/screenshot_pro_demnas.png';
import screenProBatnas from '../assets/img/screenshot_pro_batnas.png';

// Screenshots (ArcMap)
import screenArcmap1 from '../assets/img/screenshot_arcmap.png';
import screenArcmap2 from '../assets/img/screenshot_arcmap_2.png';
import screenArcmap3 from '../assets/img/screenshot_arcmap_3.png';

const tools = [
	{
		num: '01',
		name: 'Login & Panduan Token INA-Geoportal',
		spec: 'OAuth accessToken · Portal Tanah Air',
		desc: 'Membuka halaman login Ina-Geoportal dan menampilkan langkah pengambilan accessToken sementara dari tab Network untuk dipakai pada alat unduhan.',
		guideHref: '/token_guide',
		guideLabel: 'Panduan token',
		icon: 'key'
	},
	{
		num: '02',
		name: 'Download DEMNAS (Mosaic)',
		spec: 'GeoTIFF · 0.27 arc-sec (~8,3 m)',
		desc: 'Mengunduh tile Digital Elevation Model Nasional berdasarkan Grid Index dan area studi (AOI), lengkap dengan penggabungan mosaic, clip AOI, dan proyeksi CRS.',
		guideHref: '/guide_demnas',
		guideLabel: 'Panduan DEMNAS',
		icon: 'elevation'
	},
	{
		num: '03',
		name: 'Download RBI (Batch)',
		spec: 'Shapefile · 1:25.000 & 1:50.000',
		desc: 'Mengunduh Peta Rupabumi Indonesia per kabupaten/kota secara massal melalui seleksi manual atau filter polygon AOI dengan deteksi provinsi otomatis.',
		guideHref: '/guide_rbi',
		guideLabel: 'Panduan RBI',
		icon: 'map'
	},
	{
		num: '04',
		name: 'Download BATNAS',
		spec: 'GeoTIFF · Versi 1.1 & 1.5',
		desc: 'Mengunduh data Batimetri Nasional perairan Indonesia dari Grid Index BATNAS, dilengkapi mekanisme coba ulang saat gagal dan opsi mosaic.',
		guideHref: '/guide_batnas',
		guideLabel: 'Panduan BATNAS',
		icon: 'waves'
	},
	{
		num: '05',
		name: 'Download Batas Wilayah (REST API BIG)',
		spec: 'Provinsi, Kab/Kota, Kecamatan, Desa',
		desc: 'Menarik batas administrasi langsung dari layanan REST aktif BIG (BATAS_KABKOTA_AR, BATAS_KECAMATAN_AR, BATAS_DESAKEL_AR) dengan adaptive batching.',
		guideHref: null,
		guideLabel: null,
		icon: 'boundary'
	},
	{
		num: '06',
		name: 'Download Peta Cetak RBI',
		spec: 'Lembar peta cetak · Indeks area',
		desc: 'Mengunduh lembar peta cetak RBI resmi dari portal BIG sesuai area kerja untuk referensi cetak dan verifikasi lapangan.',
		guideHref: null,
		guideLabel: null,
		icon: 'sheet'
	},
	{
		num: '07',
		name: 'Import Metadata BIG',
		spec: 'Standar ISO 19115-3',
		desc: 'Mengimpor berkas metadata resmi Badan Informasi Geospasial berstandar ISO 19115-3 langsung ke layer proyek GIS Anda.',
		guideHref: null,
		guideLabel: null,
		icon: 'metadata'
	}
];

const workflowSteps = [
	{
		step: '01',
		title: 'Pasang di software GIS',
		desc: 'Pasang paket ZIP untuk QGIS (Plugin Manager), tambahkan berkas .pyt ke ArcGIS Pro, atau muat toolbox di ArcMap 10.x.'
	},
	{
		step: '02',
		title: 'Ambil token Ina-Geoportal',
		desc: 'Buka Tool #1, login ke akun Tanah Air BIG, lalu salin nilai accessToken dari request signin pada Developer Tools (F12).'
	},
	{
		step: '03',
		title: 'Pilih grid atau batas wilayah',
		desc: 'Muat layer Bahan Grid Index (DEMNAS/BATNAS) atau Batas Administrasi Kabupaten/Kota, lalu tentukan wilayah atau polygon AOI.'
	},
	{
		step: '04',
		title: 'Jalankan unduhan batch',
		desc: 'Tentukan folder output, skala peta, atau proyeksi CRS opsional, lalu klik Run. Proses unduh, mosaic, dan clip berjalan otomatis.'
	}
];

const qgisShots = [
	{ src: screenDemnas, title: 'Download DEMNAS (Mosaic)', caption: 'QGIS · Tool #2: Unduh tile DEMNAS dengan mosaic otomatis, clip AOI, dan proyeksi CRS.' },
	{ src: screenRbi, title: 'Download RBI (Batch)', caption: 'QGIS · Tool #3: Unduh Peta RBI skala 25K atau 50K per kabupaten/kota dengan filter AOI.' },
	{ src: screenBatnas, title: 'Download BATNAS', caption: 'QGIS · Tool #4: Unduh Batimetri Nasional versi 1.1 atau 1.5 dengan opsi mosaic.' },
	{ src: screenLogin, title: 'Login INA-Geoportal', caption: 'QGIS · Tool #1: Panduan langkah pengambilan accessToken dari tab Network.' }
];

const proShots = [
	{ src: screenProRbi, title: 'Download RBI', caption: 'ArcGIS Pro · Panel Geoprocessing untuk unduh batch RBI per kabupaten/kota.' },
	{ src: screenProDemnas, title: 'Download DEMNAS', caption: 'ArcGIS Pro · Panel Geoprocessing untuk unduh DEMNAS dengan opsi Clip AOI dan Output CRS.' },
	{ src: screenProBatnas, title: 'Download BATNAS', caption: 'ArcGIS Pro · Panel Geoprocessing untuk unduh data batimetri dan penggabungan mosaic.' },
	{ src: screenProLogin, title: 'Login INA-Geoportal', caption: 'ArcGIS Pro · Panel panduan autentikasi token portal Ina-Geoportal.' }
];

const arcmapShots = [
	{ src: screenArcmap1, title: 'Download DEMNAS (Mosaic)', caption: 'ArcMap 10.x · Dialog parameter unduh tile DEMNAS beserta clip AOI dan proyeksi.' },
	{ src: screenArcmap2, title: 'Download RBI', caption: 'ArcMap 10.x · Dialog parameter unduh Peta RBI skala 25K/50K.' },
	{ src: screenArcmap3, title: 'Download BATNAS', caption: 'ArcMap 10.x · Dialog parameter unduh data Batimetri Nasional.' }
];
---

<Layout title="BIG Downloader Toolbox - Unduh Data Peta BIG di QGIS, ArcGIS Pro & ArcMap">
	<!-- Section 1: Asymmetric Cartographic Hero -->
	<section class="relative overflow-x-clip border-b border-line">
		<!-- Subtle topographic contour motif (Cartographic Editorial identity) -->
		<svg
			aria-hidden="true"
			viewBox="0 0 800 560"
			fill="none"
			class="pointer-events-none select-none absolute -top-12 right-0 w-[680px] max-w-[90vw] h-auto text-ink opacity-[0.06] dark:opacity-[0.09]"
		>
			<path d="M98 44C215 10 318 68 412 46C514 22 612 -8 740 52" stroke="currentColor" stroke-width="1.2" />
			<path d="M62 112C184 74 304 134 428 106C548 78 646 42 782 118" stroke="currentColor" stroke-width="1.2" />
			<path d="M40 186C166 144 294 214 434 176C564 140 676 114 794 196" stroke="currentColor" stroke-width="1.2" />
			<path d="M84 268C206 232 322 294 456 252C578 214 684 198 796 274" stroke="currentColor" stroke-width="1.2" />
			<path d="M126 350C244 316 354 374 484 334C596 298 694 294 792 356" stroke="currentColor" stroke-width="1.2" />
			<path d="M180 434C294 402 406 448 532 412C634 382 714 386 790 438" stroke="currentColor" stroke-width="1.2" />
			<path d="M254 512C358 486 462 522 574 492C662 468 730 474 792 512" stroke="currentColor" stroke-width="1.2" />
		</svg>

		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-14 sm:pt-14 sm:pb-20 lg:pt-16 lg:pb-24 relative">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
				<!-- Left editorial column -->
				<div class="lg:col-span-5 space-y-6">
					<p class="font-mono text-xs sm:text-sm font-medium text-accent">
						Rilis v4.0.8 · QGIS 3.22-4.x · ArcGIS Pro · ArcMap 10.x
					</p>

					<h1 class="font-display font-extrabold text-[clamp(2rem,4.4vw,3.15rem)] leading-[1.12] text-ink">
						Unduh peta dasar BIG langsung dari QGIS dan ArcGIS.
					</h1>

					<p class="text-base sm:text-lg text-ink-secondary leading-relaxed">
						Satu toolbox desktop berisi 7 alat untuk mengunduh data resmi Badan Informasi Geospasial (RBI, DEMNAS, BATNAS, batas wilayah REST API, peta cetak RBI, dan metadata ISO 19115-3) secara batch langsung di area kerja GIS Anda.
					</p>

					<div class="flex flex-col sm:flex-row gap-3 pt-1">
						<a
							href="#download"
							class="min-h-[48px] px-6 inline-flex items-center justify-center rounded-md bg-accent hover:bg-accent-hover active:opacity-95 text-accent-ink text-sm sm:text-base font-semibold transition-colors"
						>
							Unduh Toolbox v4.0.8
						</a>
						<a
							href="#tools"
							class="min-h-[48px] px-6 inline-flex items-center justify-center rounded-md border border-control/70 bg-surface hover:bg-subtle text-ink text-sm sm:text-base font-semibold transition-colors"
						>
							Lihat Katalog 7 Alat
						</a>
					</div>

					<dl class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-3 pt-6 border-t border-line text-sm">
						<div>
							<dt class="font-mono text-xs text-ink-muted">Platform</dt>
							<dd class="font-semibold text-ink mt-0.5">QGIS, Pro, ArcMap</dd>
						</div>
						<div>
							<dt class="font-mono text-xs text-ink-muted">Sumber Data</dt>
							<dd class="font-semibold text-ink mt-0.5">Ina-Geoportal BIG</dd>
						</div>
						<div class="col-span-2 sm:col-span-1">
							<dt class="font-mono text-xs text-ink-muted">Lisensi</dt>
							<dd class="font-semibold text-ink mt-0.5">Gratis (aktivasi daring)</dd>
						</div>
					</dl>
				</div>

				<!-- Right product showcase column -->
				<div class="lg:col-span-7">
					<figure class="rounded-xl border border-line bg-surface shadow-xl overflow-hidden">
						<div class="px-4 py-2.5 bg-subtle/80 border-b border-line flex items-center justify-between gap-3">
							<span class="font-mono text-xs text-ink-secondary truncate">
								BIG Downloader Tools · 2. Download DEMNAS (Mosaic)
							</span>
							<span class="font-mono text-[11px] text-ink-muted shrink-0">GeoTIFF · EPSG:4326</span>
						</div>

						<div class="bg-subtle/30 p-2 sm:p-3">
							<Image
								src={screenDemnas}
								alt="Tangkapan layar Tool Download DEMNAS Mosaic di QGIS dengan pilihan DEMNAS Index Grid, Area of Interest, API Token, Clip DEM with AOI, dan Output CRS"
								width={942}
								height={854}
								loading="eager"
								fetchpriority="high"
								class="w-full h-auto block rounded-md border border-line/70"
							/>
						</div>

						<figcaption class="px-4 py-3 border-t border-line bg-surface flex flex-wrap items-center justify-between gap-2 text-xs text-ink-muted">
							<span>Antarmuka asli plugin BIG Downloader di QGIS Processing Toolbox.</span>
							<button
								type="button"
								class="gallery-trigger inline-flex items-center min-h-[44px] px-3 -my-2 rounded-md font-semibold text-accent hover:bg-accent-soft transition-colors"
								data-group="qgis"
								data-index="0"
							>
								Perbesar tampilan
							</button>
						</figcaption>
					</figure>
				</div>
			</div>
		</div>
	</section>

	<!-- Section 2: 7-Tool Technical Catalog (Asymmetric Sticky Intro + Numbered Specification Rows) -->
	<section id="tools" class="py-14 sm:py-20 lg:py-24">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
				<div class="lg:col-span-4 lg:sticky lg:top-24 space-y-6">
					<div class="space-y-3">
						<p class="font-mono text-xs font-medium text-accent">Katalog Alat</p>
						<h2 class="font-display font-bold text-2xl sm:text-3xl text-ink leading-tight">
							Tujuh alat siap pakai dalam satu toolbox.
						</h2>
						<p class="text-sm sm:text-base text-ink-secondary leading-relaxed">
							Setiap alat mengakses langsung layanan portal BIG sesuai spesifikasi format geospasial, sehingga mengurangi pekerjaan unduh manual per lembar peta.
						</p>
					</div>

					<aside class="rounded-xl border border-line bg-surface p-5 space-y-3">
						<div class="flex items-center justify-between gap-2">
							<h3 class="font-display font-bold text-sm text-ink">Catatan Rilis v4.0.8</h3>
							<span class="font-mono text-xs text-accent font-medium">Terbaru</span>
						</div>
						<ul class="space-y-2 text-sm text-ink-secondary leading-relaxed list-disc pl-4">
							<li>Pembaruan endpoint REST API Batas Wilayah BIG (<code class="font-mono text-xs text-ink">BATAS_KABKOTA_AR</code>, <code class="font-mono text-xs text-ink">BATAS_KECAMATAN_AR</code>, <code class="font-mono text-xs text-ink">BATAS_DESAKEL_AR</code>) guna mencegah galat HTTP 500.</li>
							<li>Adaptive batching otomatis menyesuaikan ukuran permintaan saat server BIG melambat.</li>
							<li>Kompatibel penuh dengan QGIS 3.22 hingga 4.x (PyQt6), ArcGIS Pro, dan ArcMap 10.x.</li>
						</ul>
						<a
							href="https://github.com/ahzastudio/bigtools-web/releases"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center min-h-[44px] text-sm font-semibold text-hydro hover:underline"
						>
							Lihat riwayat rilis di GitHub
						</a>
					</aside>
				</div>

				<div class="lg:col-span-8">
					<ol class="divide-y divide-line border-y border-line">
						{tools.map((tool) => (
							<li class="py-5 sm:py-6 flex flex-col sm:flex-row gap-4 sm:gap-6 items-start">
								<div class="flex items-center gap-3 shrink-0">
									<span class="font-mono text-xs font-medium text-ink-muted w-6">{tool.num}</span>
									<div class="w-10 h-10 rounded-md border border-line bg-surface flex items-center justify-center text-accent">
										{tool.icon === 'key' && (
											<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
												<circle cx="8" cy="15" r="4" />
												<path stroke-linecap="round" stroke-linejoin="round" d="M11.2 12.2L20 4m-3 0h3v3m-4 1l2 2" />
											</svg>
										)}
										{tool.icon === 'elevation' && (
											<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
												<path stroke-linecap="round" stroke-linejoin="round" d="M3 18l5.5-9 4 5.5 3-4.5L21 18H3z" />
												<path stroke-linecap="round" d="M3 21h18" />
											</svg>
										)}
										{tool.icon === 'map' && (
											<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
												<path stroke-linecap="round" stroke-linejoin="round" d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2V6z" />
												<path d="M9 4v14m6-12v14" />
											</svg>
										)}
										{tool.icon === 'waves' && (
											<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
												<path stroke-linecap="round" d="M3 8c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 2-2" />
												<path stroke-linecap="round" d="M3 13c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 2-2" />
												<path stroke-linecap="round" d="M3 18c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 2-2" />
											</svg>
										)}
										{tool.icon === 'boundary' && (
											<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
												<path stroke-linecap="round" stroke-linejoin="round" d="M5 6l5-2 9 3-2 9-7 4-6-4 1-10z" />
												<path stroke-linecap="round" stroke-dasharray="2 2" d="M10 4l2 16M5 10l12 2" />
											</svg>
										)}
										{tool.icon === 'sheet' && (
											<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
												<rect x="4" y="4" width="16" height="16" rx="1.5" />
												<path d="M4 10h16M10 4v16" />
											</svg>
										)}
										{tool.icon === 'metadata' && (
											<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
												<path stroke-linecap="round" stroke-linejoin="round" d="M6 3h9l4 4v14H6V3z" />
												<path stroke-linecap="round" d="M9 11h6M9 15h6M9 7h3" />
											</svg>
										)}
									</div>
								</div>

								<div class="flex-1 min-w-0 space-y-1.5">
									<div class="flex flex-wrap items-baseline justify-between gap-2">
										<h3 class="font-display font-bold text-base sm:text-lg text-ink">{tool.name}</h3>
										<span class="font-mono text-xs text-ink-muted">{tool.spec}</span>
									</div>
									<p class="text-sm sm:text-[15px] text-ink-secondary leading-relaxed">{tool.desc}</p>
									{tool.guideHref && (
										<div class="pt-1">
											<a
												href={tool.guideHref}
												class="inline-flex items-center min-h-[44px] -my-2 text-sm font-semibold text-hydro hover:underline"
											>
												{tool.guideLabel}
											</a>
										</div>
									)}
								</div>
							</li>
						))}
					</ol>
				</div>
			</div>
		</div>
	</section>

	<!-- Section 3: 4-Step Practical Workflow Band -->
	<section id="workflow" class="py-14 sm:py-16 bg-subtle/70 border-y border-line">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
				<div class="space-y-2 max-w-2xl">
					<p class="font-mono text-xs font-medium text-accent">Alur Kerja</p>
					<h2 class="font-display font-bold text-2xl sm:text-3xl text-ink">
						Dari instalasi sampai layer siap olah di peta.
					</h2>
				</div>
				<a
					href="/token_guide"
					class="inline-flex items-center min-h-[44px] px-4 rounded-md border border-control/70 bg-surface hover:bg-canvas text-sm font-semibold text-ink transition-colors self-start md:self-auto"
				>
					Baca panduan ambil Token API
				</a>
			</div>

			<ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
				{workflowSteps.map((item) => (
					<li class="rounded-xl border border-line bg-surface p-5 flex flex-col justify-between gap-3">
						<div class="space-y-2.5">
							<span class="font-mono text-xs font-medium text-accent">{item.step}</span>
							<h3 class="font-display font-bold text-base text-ink">{item.title}</h3>
							<p class="text-sm text-ink-secondary leading-relaxed">{item.desc}</p>
						</div>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- Section 4: Interactive Platform Screenshot Inspector (ARIA Tabs + Native Dialog Lightbox) -->
	<section id="gallery" class="py-14 sm:py-20 lg:py-24">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8">
				<div class="space-y-2 max-w-2xl">
					<p class="font-mono text-xs font-medium text-accent">Antarmuka Asli</p>
					<h2 class="font-display font-bold text-2xl sm:text-3xl text-ink">
						Tampilan dialog di tiap platform GIS.
					</h2>
					<p class="text-sm sm:text-base text-ink-secondary">
						Pilih tab platform untuk melihat parameter asli tiap alat. Klik gambar mana saja untuk membuka pratinjau ukuran penuh.
					</p>
				</div>

				<div
					role="tablist"
					aria-label="Pilih platform GIS"
					class="inline-flex flex-wrap gap-1.5 p-1 rounded-lg bg-subtle border border-line self-start lg:self-auto"
				>
					<button
						type="button"
						role="tab"
						id="tab-qgis"
						aria-selected="true"
						aria-controls="panel-qgis"
						tabindex="0"
						class="platform-tab min-h-[44px] px-4 rounded-md text-sm font-semibold transition-colors bg-surface text-ink border border-line"
					>
						QGIS Plugin <span class="font-mono text-xs text-ink-muted ml-1">(4)</span>
					</button>
					<button
						type="button"
						role="tab"
						id="tab-pro"
						aria-selected="false"
						aria-controls="panel-pro"
						tabindex="-1"
						class="platform-tab min-h-[44px] px-4 rounded-md text-sm font-medium transition-colors text-ink-secondary hover:text-ink border border-transparent"
					>
						ArcGIS Pro <span class="font-mono text-xs text-ink-muted ml-1">(4)</span>
					</button>
					<button
						type="button"
						role="tab"
						id="tab-arcmap"
						aria-selected="false"
						aria-controls="panel-arcmap"
						tabindex="-1"
						class="platform-tab min-h-[44px] px-4 rounded-md text-sm font-medium transition-colors text-ink-secondary hover:text-ink border border-transparent"
					>
						ArcMap 10.x <span class="font-mono text-xs text-ink-muted ml-1">(3)</span>
					</button>
				</div>
			</div>

			<!-- Tab Panel: QGIS -->
			<div role="tabpanel" id="panel-qgis" aria-labelledby="tab-qgis" class="platform-panel">
