	<script
		is:inline
		define:vars={{
			galleryData: {
				qgis: qgisShots.map((s) => ({ src: s.src.src, title: s.title, caption: s.caption })),
				pro: proShots.map((s) => ({ src: s.src.src, title: s.title, caption: s.caption })),
				arcmap: arcmapShots.map((s) => ({ src: s.src.src, title: s.title, caption: s.caption }))
			}
		}}
	>
		(function () {
			// 1. Accessible ARIA Tabs
			var tabs = Array.prototype.slice.call(document.querySelectorAll('.platform-tab'));
			var panels = Array.prototype.slice.call(document.querySelectorAll('.platform-panel'));

			function activateTab(tab, moveFocus) {
				tabs.forEach(function (t) {
					var selected = t === tab;
					t.setAttribute('aria-selected', selected ? 'true' : 'false');
					t.setAttribute('tabindex', selected ? '0' : '-1');
					t.classList.toggle('bg-surface', selected);
					t.classList.toggle('text-ink', selected);
					t.classList.toggle('font-semibold', selected);
					t.classList.toggle('border-line', selected);
					t.classList.toggle('text-ink-secondary', !selected);
					t.classList.toggle('font-medium', !selected);
					t.classList.toggle('border-transparent', !selected);
				});

				var targetId = tab.getAttribute('aria-controls');
				panels.forEach(function (panel) {
					panel.hidden = panel.id !== targetId;
				});

				if (moveFocus) {
					tab.focus();
				}
			}

			tabs.forEach(function (tab, idx) {
				tab.addEventListener('click', function () {
					activateTab(tab, false);
				});

				tab.addEventListener('keydown', function (e) {
					var nextIdx = idx;
					if (e.key === 'ArrowRight') nextIdx = (idx + 1) % tabs.length;
					else if (e.key === 'ArrowLeft') nextIdx = (idx - 1 + tabs.length) % tabs.length;
					else if (e.key === 'Home') nextIdx = 0;
					else if (e.key === 'End') nextIdx = tabs.length - 1;
					else return;

					e.preventDefault();
					activateTab(tabs[nextIdx], true);
				});
			});

			// 2. Accessible Native <dialog> Lightbox
			var dialog = document.getElementById('lightbox-dialog');
			var imgEl = document.getElementById('lightbox-img');
			var titleEl = document.getElementById('lightbox-title');
			var captionEl = document.getElementById('lightbox-caption');
			var counterEl = document.getElementById('lightbox-counter');
			var prevBtn = document.getElementById('lightbox-prev');
			var nextBtn = document.getElementById('lightbox-next');
			var closeBtn = document.getElementById('lightbox-close');

			var activeGroup = 'qgis';
			var activeIndex = 0;
			var lastTrigger = null;

			function renderLightbox() {
				var items = galleryData[activeGroup] || [];
				if (!items.length) return;
				var item = items[activeIndex];
				if (imgEl) {
					imgEl.src = item.src;
					imgEl.alt = item.caption;
				}
				if (titleEl) titleEl.textContent = item.title;
				if (captionEl) captionEl.textContent = item.caption;
				if (counterEl) counterEl.textContent = (activeIndex + 1) + ' / ' + items.length;
			}

			function openLightbox(group, index, triggerEl) {
				if (!dialog) return;
				activeGroup = group;
				activeIndex = index;
				lastTrigger = triggerEl || null;
				renderLightbox();
				if (typeof dialog.showModal === 'function') {
					dialog.showModal();
				} else {
					dialog.setAttribute('open', '');
				}
				if (closeBtn) closeBtn.focus();
			}

			function closeLightbox() {
				if (!dialog) return;
				if (typeof dialog.close === 'function') {
					dialog.close();
				} else {
					dialog.removeAttribute('open');
				}
				if (lastTrigger && typeof lastTrigger.focus === 'function') {
					lastTrigger.focus();
				}
			}

			function stepLightbox(delta) {
				var items = galleryData[activeGroup] || [];
				if (!items.length) return;
				activeIndex = (activeIndex + delta + items.length) % items.length;
				renderLightbox();
			}

			document.querySelectorAll('.gallery-trigger').forEach(function (btn) {
				btn.addEventListener('click', function () {
					var group = btn.getAttribute('data-group') || 'qgis';
					var index = parseInt(btn.getAttribute('data-index') || '0', 10);
					openLightbox(group, index, btn);
				});
			});

			if (prevBtn) prevBtn.addEventListener('click', function () { stepLightbox(-1); });
			if (nextBtn) nextBtn.addEventListener('click', function () { stepLightbox(1); });
			if (closeBtn) closeBtn.addEventListener('click', closeLightbox);

			if (dialog) {
				dialog.addEventListener('click', function (e) {
					if (e.target === dialog) {
						closeLightbox();
					}
				});

				dialog.addEventListener('keydown', function (e) {
					if (e.key === 'ArrowLeft') {
						e.preventDefault();
						stepLightbox(-1);
					} else if (e.key === 'ArrowRight') {
						e.preventDefault();
						stepLightbox(1);
					}
				});

				dialog.addEventListener('close', function () {
					if (lastTrigger && typeof lastTrigger.focus === 'function') {
						lastTrigger.focus();
					}
				});
			}
		})();
	</script>
